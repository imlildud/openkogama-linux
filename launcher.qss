QPushButton {
    background: @button@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 4px;
    padding: 0 14px;
    min-height: 26px;
}
QPushButton:hover { background: @hover@; border-color: @hover-border@; }
QPushButton:pressed { background: @pressed@; }
QPushButton:disabled { background: @disabled@; color: @disabled-text@; border-color: @disabled-border@; }
QPushButton:flat { background: transparent; border: none; }
QPushButton:flat:hover { background: @button@; }

QPushButton[primary="true"] { background: #3a7a80; color: #ffffff; border: 1px solid #3a7a80; font-weight: bold; padding-left: 20px; padding-right: 20px; }
QPushButton[primary="true"]:hover { background: #438a90; border-color: #438a90; }
QPushButton[primary="true"]:pressed { background: #2c5e63; border-color: #2c5e63; }
QPushButton[primary="true"]:disabled { background: @disabled@; color: @disabled-text@; border-color: @disabled-border@; }

QPushButton#playButton, QPushButton#buildButton, QPushButton#useAvatarButton,
QPushButton#editAvatarButton, QPushButton#useVersionButton, QPushButton#joinServerButton { font-size: 11pt; min-height: 34px; }
QPushButton#openWorldsButton, QPushButton#firstVersionButton, QPushButton#noVersionsButton { min-height: 34px; }

QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0 6px;
    font-size: 16px;
}
QToolButton:hover { background: @button@; }
QToolButton:disabled { color: @disabled-text@; }
QToolButton::menu-indicator { image: none; width: 0; }
QToolButton#addVersionButton { background: @button@; border: 1px solid @border@; }
QToolButton#addVersionButton:hover { background: @hover@; border-color: @hover-border@; }

QLineEdit {
    background: @field@;
    border: 1px solid @border@;
    border-radius: 4px;
    padding: 0 8px;
    min-height: 26px;
}
QLineEdit:focus { border-color: #3a7a80; }
QListView QLineEdit { min-height: 0; padding: 0 4px; }

QComboBox {
    background: @button@;
    border: 1px solid @border@;
    border-radius: 4px;
    padding: 0 8px;
    min-height: 26px;
}
QComboBox:hover { background: @hover@; border-color: @hover-border@; }
QComboBox:disabled { background: @disabled@; color: @disabled-text@; border-color: @disabled-border@; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow { image: url(@arrow@); width: 10px; height: 10px; }
QComboBox QAbstractItemView {
    background: @field@;
    border: 1px solid @border@;
    outline: 0;
}

QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:vertical { background: @scroll@; border-radius: 3px; min-height: 32px; margin: 2px; }
QScrollBar::handle:horizontal { background: @scroll@; border-radius: 3px; min-width: 32px; margin: 2px; }
QScrollBar::handle:hover { background: @scroll-hover@; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QTabBar { qproperty-drawBase: 0; }
QTabWidget::pane { border: none; }
QTabBar::tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 7px 0;
    margin-right: 24px;
    color: @muted@;
}
QTabBar::tab:hover { color: @text@; }
QTabBar::tab:selected { color: @text@; border-bottom: 2px solid #3a7a80; }
QTabBar::tab:disabled { color: @disabled-text@; }

QListView { background: palette(window); }
QListView#instancesView::item { padding: 4px 0; }
QAbstractItemView, QLineEdit, QPlainTextEdit, QTextEdit { selection-background-color: #3a7a80; selection-color: #ffffff; }
QTreeView { alternate-background-color: @alternate@; }

QLabel#selectedWorldLabel, QLabel#selectedAvatarLabel, QLabel#instanceNameLabel, QLabel#selectedServerLabel { font-weight: bold; font-size: 11pt; }
QLabel#instanceVersionLabel, QLabel#selectedServerAddress { color: @muted@; }

QPushButton:default { border-color: @hover-border@; }
QDialogButtonBox QPushButton { min-width: 58px; }
QDialogButtonBox QPushButton[primary="true"] { padding-left: 14px; padding-right: 14px; }

QToolButton#addVersionButton { padding: 0; min-width: 26px; max-width: 26px; min-height: 26px; max-height: 26px; qproperty-icon: url(@plus@); qproperty-iconSize: 12px 12px; }
QToolButton#moreWorldButton, QToolButton#moreAvatarButton,
QToolButton#moreVersionButton, QToolButton#moreServerButton { padding: 0; min-width: 36px; max-width: 36px; min-height: 36px; max-height: 36px; }

QMenuBar { background: transparent; }
QMenuBar::item { padding: 4px 8px; background: transparent; border-radius: 4px; }
QMenuBar::item:selected, QMenuBar::item:pressed { background: @button@; }
QMenu { background: @field@; border: 1px solid @border@; padding: 4px; }
QMenu::item { padding: 6px 24px 6px 12px; border-radius: 4px; }
QMenu::item:selected { background: #3a7a80; color: #ffffff; }
QMenu::item:disabled { color: @disabled-text@; }
QMenu::separator { height: 1px; background: @separator@; margin: 4px 8px; }

QToolTip { background: @field@; color: @text@; border: 1px solid @border@; padding: 4px 6px; }

QHeaderView::section { background: @field@; color: @muted@; border: none; border-bottom: 1px solid @separator@; padding: 4px 6px; }
QTreeView::item { padding: 3px 0; }

QGroupBox { border: none; margin-top: 20px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 0; padding: 0; color: @text@; }

QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid @check-border@; border-radius: 3px; background: @field@; }
QCheckBox::indicator:hover { border-color: #3a7a80; }
QCheckBox::indicator:checked { background: #3a7a80; border-color: #3a7a80; image: url(:/check.svg); }

QProgressBar { background: @field@; border: 1px solid @border@; border-radius: 4px; text-align: center; color: @text@; }
QProgressBar::chunk { background: #3a7a80; border-radius: 3px; }
